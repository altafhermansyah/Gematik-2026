// KarsaLoka — Prisma schema (PostgreSQL), 10 tabel
// URL database ada di prisma.config.ts; client memakai driver adapter (@prisma/adapter-pg).
//
// LocalizedText = Json berbentuk { "id": "...", "en": "..." }
// Validasi dengan Zod di sisi aplikasi (lib/i18n/localized.ts). Fallback: locale lain.
//
// Tidak ada akun pengguna. Progres, bookmark, dan hasil kuis disimpan di browser (localStorage).
// Kuis (pertanyaan + bobot) berada di kode: modules/quiz.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Enums ─────────────────────────

enum PublishStatus {
  DRAFT
  PUBLISHED
}

enum Level {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum NodeType {
  CONCEPT
  PRACTICE
  PROJECT
}

enum ResourceType {
  VIDEO
  ARTICLE
  COURSE
  BOOK
  DOCS
  TOOL
}

// ───────────────────────── Admin ─────────────────────────

// Satu-satunya akun yang bisa login. Dibuat lewat seed, tidak ada pendaftaran publik.
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

// ───────────────────────── Atlas: masalah dan inovasi ─────────────────────────

// Bidang: iklim, pangan, kesehatan, pendidikan, kebencanaan, inklusi.
model Domain {
  id    String @id @default(cuid())
  slug  String @unique
  name  Json // LocalizedText
  color String // hex, dipakai untuk titik globe dan chip
  icon  String?
  order Int    @default(0)

  cases Case[]
  paths Path[]
}

// Satu studi kasus = satu titik di globe + satu halaman detail
model Case {
  id       String        @id @default(cuid())
  slug     String        @unique
  domainId String
  status   PublishStatus @default(DRAFT)
  featured Boolean       @default(false)

  title    Json // LocalizedText
  summary  Json // LocalizedText (1-2 kalimat untuk daftar dan panel)
  problem  Json // LocalizedText
  solution Json // LocalizedText
  aiRole   Json // LocalizedText (peran AI/teknologi)
  impact   Json // LocalizedText
  metrics  Json? // [{ label: LocalizedText, value: number, unit: string }], hanya angka yang terverifikasi

  countryCode  String // ISO-2, contoh "ID"
  region       String?
  lat          Float
  lng          Float
  year         Int?
  sdgs         Int[] // 1..17
  technologies String[] // tag, contoh ["computer-vision", "iot"]
  coverImage   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  domain  Domain       @relation(fields: [domainId], references: [id])
  sources CaseSource[]
  paths   CasePath[]

  @@index([status, domainId])
  @@index([countryCode])
  @@index([sdgs], type: Gin)
  @@index([technologies], type: Gin)
}

// Rujukan tiap kasus. Kasus PUBLISHED wajib punya minimal satu.
model CaseSource {
  id         String    @id @default(cuid())
  caseId     String
  title      String
  publisher  String?
  url        String
  accessedAt DateTime?

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

// ───────────────────────── Roadmap: skill dan jalur ─────────────────────────

// Katalog skill, dipakai ulang di banyak jalur
model Skill {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        Json // LocalizedText
  description Json? // LocalizedText
  category    String? // contoh "programming", "data", "ml", "ethics"

  nodes     PathNode[]
  resources Resource[]
}

// Materi belajar per skill
model Resource {
  id       String       @id @default(cuid())
  skillId  String
  type     ResourceType
  title    String
  url      String
  provider String?
  lang     String       @default("en")
  free     Boolean      @default(true)
  order    Int          @default(0)

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([skillId])
}

// Satu jalur belajar = satu graph
model Path {
  id             String        @id @default(cuid())
  slug           String        @unique
  domainId       String? // opsional: jalur dasar berlaku lintas bidang
  status         PublishStatus @default(DRAFT)
  level          Level         @default(BEGINNER)
  title          Json // LocalizedText
  description    Json // LocalizedText
  estimatedHours Int?
  coverImage     String?

  domain Domain?    @relation(fields: [domainId], references: [id])
  nodes  PathNode[]
  cases  CasePath[]

  @@index([status])
}

// Node di graph: satu skill dalam satu jalur
model PathNode {
  id             String   @id @default(cuid())
  pathId         String
  skillId        String
  type           NodeType @default(CONCEPT)
  order          Int // urutan linear (tampilan list/mobile)
  posX           Float? // posisi di canvas graph
  posY           Float?
  estimatedHours Int?
  task           Json? // LocalizedText: tugas latihan/proyek spesifik node ini

  path     Path       @relation(fields: [pathId], references: [id], onDelete: Cascade)
  skill    Skill      @relation(fields: [skillId], references: [id])
  outgoing PathEdge[] @relation("EdgeFrom")
  incoming PathEdge[] @relation("EdgeTo")

  @@unique([pathId, skillId])
  @@index([pathId, order])
}

// Prasyarat: from -> to. Kedua node harus berada di jalur yang sama (dicek di seed dan admin).
model PathEdge {
  id     String @id @default(cuid())
  fromId String
  toId   String

  from PathNode @relation("EdgeFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   PathNode @relation("EdgeTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
}

// Jembatan Atlas -> Roadmap: tombol "Jadi bagian solusinya"
model CasePath {
  caseId    String
  pathId    String
  relevance Int    @default(1) // 1..3, untuk urutan rekomendasi
  note      Json? // LocalizedText: kenapa jalur ini relevan untuk kasus ini

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  path Path @relation(fields: [pathId], references: [id], onDelete: Cascade)

  @@id([caseId, pathId])
}
